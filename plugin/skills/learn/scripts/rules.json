{
 "base": {
  "freedom": null,
  "kind": "base",
  "label": null,
  "rules": [
   {
    "extends": "existence",
    "id": "ScribbBase.AIVocabulary",
    "ignorecase": true,
    "level": "error",
    "message": "'%s' is a common AI-writing tell. Use a plain word, or cut it.",
    "tokens": [
     "delv(?:e|es|ed|ing)",
     "(?:rich )?tapestry",
     "(?:a|is a|stands as a) testament to",
     "in today's (?:fast-paced|digital|ever-changing) (?:world|landscape|age)",
     "navigat(?:e|es|ing) the complexities",
     "unlock(?:s|ing)? the (?:full )?(?:power|potential) of",
     "harness(?:es|ing)? the (?:full )?power of",
     "ever-evolving",
     "plays? a (?:pivotal|crucial|vital) role",
     "in the realm of",
     "game[- ]changer",
     "supercharg(?:e|es|ed|ing)",
     "embark(?:s|ing)? on (?:a|an|your) journey",
     "multifaceted"
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbBase.ChatResidue",
    "ignorecase": true,
    "level": "error",
    "message": "'%s' is chat residue. Remove it from written output.",
    "tokens": [
     "great question",
     "I hope this helps",
     "I hope that helps",
     "certainly!",
     "absolutely!",
     "as an AI(?: language model)?",
     "let me know if you have any (?:other |further |more )?questions",
     "feel free to reach out",
     "I'd be (?:happy|glad) to",
     "I would be (?:happy|glad) to"
    ]
   },
   {
    "extends": "occurrence",
    "id": "ScribbBase.EmDashes",
    "level": "warning",
    "max": 2,
    "message": "More than two em dashes in one paragraph. Use commas, colons or full stops for some of them.",
    "scope": "paragraph",
    "token": "—"
   },
   {
    "extends": "existence",
    "id": "ScribbBase.NotJustButAlso",
    "ignorecase": true,
    "level": "error",
    "message": "Avoid 'not just X, but Y' framing. State the point directly.",
    "nonword": true,
    "tokens": [
     "\\b(?:not just|not only|not merely|not simply)\\b[^.!?;]{1,60}?,?\\s+but(?: also)?\\b",
     "\\b(?:isn't|is not|aren't|are not|wasn't|it's not)\\s+(?:just|merely|only|simply)\\b[^.!?]{1,60}?[,;:—–]\\s*(?:it's|it is|they're|they are|this is|but)\\b"
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbBase.Signposting",
    "ignorecase": true,
    "level": "error",
    "message": "'%s' announces the content instead of giving it. Start with the content.",
    "tokens": [
     "let's dive (?:in|into)",
     "let's break (?:it|this|that) down",
     "here's the thing",
     "in this (?:article|post|guide|blog post), (?:we|I) will",
     "without further ado",
     "buckle up"
    ]
   }
  ],
  "tagline": "Universal rules against AI writing habits. Always on.",
  "version": "0.1.0"
 },
 "crisp-product-ui": {
  "freedom": null,
  "kind": "style",
  "label": null,
  "rules": [
   {
    "extends": "substitution",
    "id": "CrispProductUi.Terms",
    "ignorecase": true,
    "level": "suggestion",
    "message": "Consider '%s' instead of '%s'.",
    "swap": {
     "click": "select",
     "click on": "select",
     "e-mail": "email",
     "log into": "log in to",
     "login to": "log in to",
     "sign into": "sign in to"
    }
   }
  ],
  "tagline": "Plain, compact interface copy that never makes people read twice.",
  "version": "0.1.0"
 },
 "developer-docs": {
  "freedom": "strict",
  "kind": "content-type",
  "label": "Developer docs",
  "rules": [
   {
    "extends": "existence",
    "id": "ScribbDevDocs.Exclamation",
    "level": "warning",
    "message": "Don't use exclamation marks in docs.",
    "nonword": true,
    "scope": "sentence",
    "tokens": [
     "\\w!(?:\\s|$)"
    ]
   },
   {
    "exceptions": [
     "AI",
     "iOS",
     "iPadOS",
     "macOS",
     "watchOS",
     "tvOS",
     "iPhone",
     "iPad",
     "iCloud",
     "npm",
     "pnpm",
     "gRPC",
     "jQuery",
     "eBay",
     "pytest",
     "API",
     "APIs",
     "CLI",
     "CSS",
     "GitHub",
     "GitLab",
     "HTML",
     "HTTP",
     "HTTPS",
     "ID",
     "JSON",
     "JavaScript",
     "Markdown",
     "Node.js",
     "OAuth",
     "README",
     "REST",
     "SDK",
     "SQL",
     "TypeScript",
     "UI",
     "URL",
     "URLs",
     "YAML"
    ],
    "extends": "capitalization",
    "id": "ScribbDevDocs.HeadingCase",
    "indicators": [
     ":"
    ],
    "level": "warning",
    "match": "$sentence",
    "message": "Use sentence case for headings: '%s'.",
    "scope": "heading",
    "threshold": 0.5
   },
   {
    "extends": "substitution",
    "id": "ScribbDevDocs.LatinAbbrev",
    "ignorecase": true,
    "level": "warning",
    "message": "Use '%s' instead of '%s'.",
    "nonword": true,
    "swap": {
     "\\be\\.g\\.": "for example",
     "\\betc\\.": "and so on",
     "\\bi\\.e\\.": "that is"
    }
   },
   {
    "extends": "existence",
    "id": "ScribbDevDocs.LinkText",
    "ignorecase": true,
    "level": "warning",
    "message": "Use link text that says where the link goes, not '%s'.",
    "nonword": true,
    "scope": "raw",
    "tokens": [
     "\\[(?:here|click here|this link|this page|link|read more|more)\\]\\("
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbDevDocs.Please",
    "ignorecase": true,
    "level": "warning",
    "message": "Remove 'please' from instructions.",
    "tokens": [
     "please"
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbDevDocs.Trivializers",
    "ignorecase": true,
    "level": "warning",
    "message": "Don't use '%s'. What's easy for you may not be easy for the reader.",
    "tokens": [
     "simply",
     "easily",
     "obviously",
     "of course",
     "straightforward",
     "just (?:run|click|select|type|add|use|open|call|set|go|copy|paste|follow|install|enter|change|create|replace|edit)"
    ]
   }
  ],
  "tagline": "Exact reference and guides for developers writing code against the product, from API, SDK and CLI reference to integration guides.",
  "version": "0.1.0"
 },
 "direct-developer-docs": {
  "freedom": null,
  "kind": "style",
  "label": null,
  "rules": [
   {
    "extends": "substitution",
    "id": "DirectDeveloperDocs.WordyPhrases",
    "ignorecase": true,
    "level": "suggestion",
    "message": "Consider '%s' instead of '%s'.",
    "swap": {
     "a number of": "some (or the number)",
     "are able to": "can",
     "at this point in time": "now",
     "in order to": "to",
     "is able to": "can",
     "leverag(?:e|es|ed|ing)": "use",
     "prior to": "before",
     "utiliz(?:e|es|ed|ing)": "use"
    }
   }
  ],
  "tagline": "Short sentences, the imperative, and nothing the reader has to skip.",
  "version": "0.1.0"
 },
 "newsletter": {
  "freedom": "balanced",
  "kind": "content-type",
  "label": "Newsletter",
  "rules": [
   {
    "extends": "existence",
    "id": "ScribbNewsletter.EmailCliches",
    "ignorecase": true,
    "level": "warning",
    "message": "'%s' is a stock email opener. Start with the news.",
    "tokens": [
     "(?:I |we )?hope (?:this|the|my|our) (?:email|e-mail|message|note|newsletter) finds you(?: well| safe| healthy)?",
     "(?:I |we )?trust (?:this|the|my) (?:email|e-mail|message|note) finds you(?: well)?",
     "as per (?:my|our) (?:last|previous) (?:email|e-mail|message)"
    ]
   },
   {
    "extends": "occurrence",
    "id": "ScribbNewsletter.ExclamationCount",
    "level": "warning",
    "max": 2,
    "message": "More than two exclamation marks in one paragraph. Keep one, at most.",
    "scope": "paragraph",
    "token": "\\w!"
   },
   {
    "extends": "existence",
    "id": "ScribbNewsletter.ExclamationStack",
    "level": "warning",
    "message": "Use one exclamation mark at most, not '%s'.",
    "nonword": true,
    "scope": "sentence",
    "tokens": [
     "!{2,}",
     "\\?+!+[!?]*",
     "!+\\?+[!?]*"
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbNewsletter.HypeAnnouncements",
    "ignorecase": true,
    "level": "warning",
    "message": "'%s' tells the reader how to feel about the news. Say what changed instead.",
    "tokens": [
     "(?:thrilled|delighted|stoked|ecstatic|over the moon) to (?:announce|share|introduce|unveil|launch|reveal)",
     "(?:super|so|beyond|incredibly|very|really) excited to (?:announce|share|introduce|unveil|launch|reveal)",
     "excited to (?:announce|unveil|reveal)"
    ]
   },
   {
    "extends": "existence",
    "id": "ScribbNewsletter.LinkText",
    "ignorecase": true,
    "level": "warning",
    "message": "Use link text that says where the link goes, not '%s'.",
    "nonword": true,
    "scope": "raw",
    "tokens": [
     "\\[(?:here|click here|this link|link|read more|more)\\]\\("
    ]
   }
  ],
  "tagline": "Newsletters people open and read, for founders and creators sending issues, updates and welcome emails.",
  "version": "0.1.0"
 },
