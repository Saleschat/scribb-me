#!/usr/bin/env bash
# scribb-config: reads and writes scribb settings for the skills.
#
# Usage:
#   scribb-config status [--session ID]          effective settings and active packs
#   scribb-config get KEY [--session ID]
#   scribb-config set KEY VALUE --scope SCOPE [--session ID]
#   scribb-config unset KEY --scope SCOPE [--session ID]
#   scribb-config off [--session ID | --repo | --team | --everywhere]
#   scribb-config on  [--session ID | --repo | --team | --everywhere]
#   scribb-config packs [--kind KIND]            id, kind, scope, version, tagline
#   scribb-config paths                          where each scope lives
#   scribb-config approver                       who to record as the approver
#   scribb-config inbox                          every pending inbox signal, with its file name
#   scribb-config approvals                      the cross-project approvals index
#   scribb-config memories                       every approved memory, with its scope and file
#   scribb-config doctor                         environment, checker and the last hook runs
#   scribb-config versions                       scribb, pack, Vale and OS versions (for reports)
#   scribb-config hash FILE...                   a sha256 content hash per file (for sources.json)
#   scribb-config record-approval SCOPE STATEMENT
#                                                adds an approved memory to the cross-project
#                                                index; prints how many repos approved it
#
# SCOPE is session, local (this repo, just me), project (this repo, whole team)
# or user (everywhere, for me).
set -u

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../lib/scribb.sh
. "$SELF_DIR/../lib/scribb.sh"

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 3; }

cmd="${1:-}"
[ $# -gt 0 ] && shift
SCRIBB_SESSION="${SCRIBB_SESSION:-}"
scope="" kind="" target="" args="" saw_session=no
while [ $# -gt 0 ]; do
  case "$1" in
    --session) SCRIBB_SESSION="$2"; saw_session=yes; shift 2 ;;
    --scope) scope="$2"; shift 2 ;;
    --kind) kind="$2"; shift 2 ;;
    --repo) target=local; shift ;;
    --team) target=project; shift ;;
    --everywhere) target=user; shift ;;
    *) args="$args$1"$'\n'; shift ;;
  esac
done
# A scope flag (--repo, --team, --everywhere) always wins; --session alone
# means the session scope. Skills pass --session on every call.
[ -z "$target" ] && [ "$saw_session" = yes ] && target=session
arg1=$(printf '%s' "$args" | sed -n 1p)
arg2=$(printf '%s' "$args" | sed -n 2p)

SCRIBB_PROJECT=$(scribb_project_dir "$PWD")
export SCRIBB_PROJECT SCRIBB_SESSION

valid_value() {
  case "$1" in
    enabled) case "$2" in true | false) return 0 ;; esac ;;
    freedom | write_freedom) case "$2" in strict | balanced | expressive) return 0 ;; esac ;;
    reviewer) case "$2" in off | auto | always) return 0 ;; esac ;;
    checker) case "$2" in vale | builtin | none) return 0 ;; esac ;;
    capture | inject | nudges | write_session) case "$2" in on | off) return 0 ;; esac ;;
    style)
      [ "$2" = none ] && return 0
      local d
      d=$(pack_dir "$2") && [ "$(pack_field "$d" kind)" = style ] && return 0
      echo "scribb-config: no style pack called '$2'. See: scribb-config packs --kind style" >&2
      return 1 ;;
    content_type) content_type_ids | grep -qx "$2" && return 0 ;;
    feedbackRate) printf '%s' "$2" | grep -Eq '^(0(\.[0-9]+)?|1(\.0+)?)$' && return 0 ;;
    paths_*) return 0 ;;
    *) echo "scribb-config: unknown setting '$1'" >&2; return 1 ;;
  esac
  echo "scribb-config: '$2' isn't a valid value for $1" >&2
  return 1
}

show_setting() {
  printf '  %-13s %-28s (%s)\n' "$1" "$(cfg "$1")" "$(cfg_scope "$1")"
}

case "$cmd" in
  status)
    if scribb_disabled; then
      if [ "${SCRIBB_DISABLE:-}" != "" ]; then
        echo "scribb.me is OFF (SCRIBB_DISABLE=$SCRIBB_DISABLE)."
      else
        echo "scribb.me is OFF (enabled: false, set in the $(cfg_scope enabled) scope)."
      fi
    else
      echo "scribb.me is on."
    fi
    echo "Project: $SCRIBB_PROJECT"
    echo "Settings (value, and the scope that set it):"
    for k in style freedom reviewer checker capture inject nudges; do
      show_setting "$k"
    done
    echo "Content types (files; default freedom; now):"
    for ct in $(content_type_ids); do
      if d=$(pack_dir "$ct"); then
        printf '  %-13s %s\n                (%s; %s; now %s)\n' "$(content_type_label "$ct")" "$(pack_field "$d" tagline)" "$(ct_paths "$ct" | sed 's/^$/no default files: chosen per page/')" "$(pack_field "$d" freedom)" "$(freedom_for "$ct")"
      fi
    done
    st=$(cfg style)
    if ! is_off "$st" && d=$(pack_dir "$st"); then
      echo "Style: $st — $(pack_field "$d" tagline) ($d)"
    else
      echo "Style: none (neutral house style: base + content type)"
    fi
    case "$(scribb_engine)" in
      vale) echo "Checker: $(vale --version 2>/dev/null)" ;;
      builtin) echo "Checker: built-in (Python)$(command -v vale >/dev/null 2>&1 || echo '; install Vale for editor and CI integration')" ;;
      *) echo "Checker: off or unavailable (no Vale, no python3)" ;;
    esac
    n=0
    for dir in "$SCRIBB_PROJECT/.scribb/local/memories" "$SCRIBB_PROJECT/.scribb/memories" "$(scribb_user_dir)/memories"; do
      [ -d "$dir" ] && n=$((n + $(find "$dir" -maxdepth 1 -name '*.md' | wc -l)))
    done
    inbox=0
    [ -d "$SCRIBB_PROJECT/.scribb/local/inbox" ] && inbox=$(find "$SCRIBB_PROJECT/.scribb/local/inbox" -maxdepth 1 -name '*.md' | wc -l | awk '{print $1}')
    echo "Memories: $n; inbox: $inbox pending"
    ;;
  get)
    [ -n "$arg1" ] || usage
    cfg "$arg1"
    ;;
  set)
    if [ -z "$arg1" ] || [ -z "$arg2" ] || [ -z "$scope" ]; then usage; fi
    valid_value "$arg1" "$arg2" || exit 1
    f=$(scribb_config_file_for_scope "$scope") || usage
    [ "$scope" = local ] && scribb_ensure_local_dir "$SCRIBB_PROJECT" >/dev/null
    yaml_set "$f" "$arg1" "$arg2"
    # A new write session gets a fresh Stop-hook retry budget.
    [ "$arg1" = write_session ] && [ -n "$SCRIBB_SESSION" ] && rm -f "$(session_dir)/stop-lint"
    echo "Set $arg1: $arg2 in the $scope scope ($f)."
    ;;
  unset)
    if [ -z "$arg1" ] || [ -z "$scope" ]; then usage; fi
    f=$(scribb_config_file_for_scope "$scope") || usage
    yaml_unset "$f" "$arg1"
    echo "Removed $arg1 from the $scope scope."
    ;;
  off | on)
    [ -n "$target" ] || usage
    f=$(scribb_config_file_for_scope "$target") || usage
    [ "$target" = local ] && scribb_ensure_local_dir "$SCRIBB_PROJECT" >/dev/null
    if [ "$cmd" = off ]; then
      yaml_set "$f" enabled false
      case "$target" in
        session) echo "scribb.me is off for this session." ;;
        local) echo "scribb.me is off in this repo, for you ($f)." ;;
        project) echo "scribb.me is off in this repo for the whole team ($f). Commit the file to share it." ;;
        user) echo "scribb.me is off everywhere for you ($f)." ;;
      esac
    else
      yaml_set "$f" enabled true
      echo "scribb.me is on in the $target scope."
      if scribb_disabled; then
        echo "Note: it's still off because of SCRIBB_DISABLE or a higher-precedence scope ($(cfg_scope enabled))."
      fi
    fi
    ;;
  packs)
    list_pack_dirs | while IFS="$(printf '\t')" read -r s d; do
      k=$(pack_field "$d" kind)
      [ -z "$kind" ] || [ "$kind" = "$k" ] || continue
      printf '%s\t%s\t%s\t%s\t%s\n' "$(pack_field "$d" id)" "$k" "$s" "$(pack_field "$d" version)" "$(pack_field "$d" tagline)"
    done
    ;;
  paths)
    echo "plugin:  $(scribb_plugin_root)"
    echo "user:    $(scribb_user_dir)"
    echo "project: $SCRIBB_PROJECT/.scribb"
    echo "local:   $SCRIBB_PROJECT/.scribb/local"
    echo "state:   $(scribb_state_dir)"
    ;;
  approver) scribb_approver ;;
  inbox)
    dir="$SCRIBB_PROJECT/.scribb/local/inbox"
    rej="$SCRIBB_PROJECT/.scribb/local/rejected.txt"
    n=0
    for f in "$dir"/*.md; do
      [ -f "$f" ] || continue
      n=$((n + 1))
      printf '===== %s =====\n' "${f#"$SCRIBB_PROJECT"/}"
      cat "$f"
      echo
    done
    [ "$n" -eq 0 ] && echo "The inbox is empty."
    if [ -s "$rej" ]; then
      echo "===== already rejected (don't suggest again) ====="
      cat "$rej"
    fi
    ;;
  approvals)
    idx="$(scribb_user_dir)/approvals.index"
    if [ -s "$idx" ]; then cat "$idx"; else echo "No approvals recorded yet."; fi
    ;;
  memories)
    n=0
    for scope in local project user; do
      case "$scope" in
        local) dir="$SCRIBB_PROJECT/.scribb/local/memories" ;;
        project) dir="$SCRIBB_PROJECT/.scribb/memories" ;;
        user) dir="$(scribb_user_dir)/memories" ;;
      esac
      for f in "$dir"/*.md; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        printf '%s\t%s\t%s\n' "$scope" "$(yaml_get "$f" statement)" "$f"
      done
    done
    [ "$n" -eq 0 ] && echo "No memories yet."
    ;;
  doctor)
    echo "scribb.me doctor"
    echo "  plugin root:      $(scribb_plugin_root)"
    echo "  project folder:   $SCRIBB_PROJECT"
    echo "  working folder:   $PWD"
    echo "  CLAUDE_PROJECT_DIR: ${CLAUDE_PROJECT_DIR:-(not set)}"
    echo "  user scope:       $(scribb_user_dir) ($([ -d "$(scribb_user_dir)" ] && echo exists || echo missing))"
    echo "  state:            $(scribb_state_dir)"
    echo "  vale:             $(command -v vale || echo 'not installed')"
    echo "  python3:          $(command -v python3 || echo 'not installed')"
    echo "  checker in use:   $(scribb_engine | sed 's/^$/none/')"
    if scribb_disabled; then echo "  scribb is OFF"; fi
    log="$(scribb_state_dir)/hook.log"
    if [ -s "$log" ]; then
      echo "Last hook runs (newest last):"
      tail -n 15 "$log" | sed 's/^/  /'
    else
      echo "No hook runs recorded in $log. If you've edited a Markdown or TSX file in this session, the hooks didn't run."
    fi
    ;;
  versions)
    root=$(scribb_plugin_root)
    echo "scribb: $(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -n 1)"
    list_pack_dirs | while IFS="$(printf '\t')" read -r s d; do
      printf 'pack %s %s (%s)\n' "$(pack_field "$d" id)" "$(pack_field "$d" version)" "$s"
    done
    if command -v vale >/dev/null 2>&1; then echo "vale: $(vale --version 2>/dev/null | awk '{print $NF}')"; else echo "vale: not installed"; fi
    if command -v sw_vers >/dev/null 2>&1; then echo "os: macOS $(sw_vers -productVersion)"; else echo "os: $(uname -sr)"; fi
    ;;
  hash)
    [ -n "$arg1" ] || usage
    printf '%s' "$args" | while IFS= read -r f; do
      [ -n "$f" ] || continue
      if command -v shasum >/dev/null 2>&1; then
        h=$(shasum -a 256 "$f" | awk '{print $1}')
      elif command -v sha256sum >/dev/null 2>&1; then
        h=$(sha256sum "$f" | awk '{print $1}')
      else
        h="cksum-$(cksum "$f" | awk '{print $1}')"
      fi
      printf 'sha256:%s\t%s\n' "$h" "$f"
    done
    ;;
  record-approval)
    if [ -z "$arg1" ] || [ -z "$arg2" ]; then usage; fi
    idx="$(scribb_user_dir)/approvals.index"
    mkdir -p "$(dirname "$idx")"
    repo=$(basename "$SCRIBB_PROJECT")
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$arg1" "$repo" "$arg2" >> "$idx"
    n=$(awk -F '\t' -v s="$arg2" '$4 == s { print $3 }' "$idx" | sort -u | wc -l | tr -d ' ')
    echo "Recorded. Approved in $n repo(s)."
    [ "$n" -ge 2 ] && echo "Suggest saving it for every repo (user scope)."
    ;;
  *) usage ;;
esac
